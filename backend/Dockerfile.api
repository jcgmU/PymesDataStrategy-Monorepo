# Production Dockerfile for API Gateway
# Build context: backend/
# docker build -f Dockerfile.api -t pymes-api .

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-workspace.yaml ./
COPY api/package.json api/
COPY prisma/ prisma/

RUN pnpm install
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

COPY api/ api/

RUN pnpm --filter @pymes/api build

# ---

FROM node:22-alpine AS runner

WORKDIR /app

# Copy pre-built artifacts — avoids re-running pnpm install with its
# native compilation and build-script approval requirements in production.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/api/dist ./api/dist

COPY prisma/ prisma/
COPY api/package.json api/
COPY api/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "api/dist/index.js"]
