# Production Dockerfile for API Gateway
# Build context: backend/
# docker build -f Dockerfile.api -t pymes-api .

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-workspace.yaml ./
COPY api/package.json api/
COPY prisma/ prisma/

# Full install (dev deps needed for prisma CLI + tsc)
RUN pnpm install
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

COPY api/ api/

RUN pnpm --filter @pymes/api build

# ---

FROM node:22-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-workspace.yaml ./
COPY api/package.json api/
COPY prisma/ prisma/

# Prod-only install for @prisma/client runtime
RUN pnpm install --prod

# Copy generated Prisma client from builder (avoids needing prisma CLI at runtime)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

COPY --from=builder /app/api/dist api/dist
COPY api/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["pnpm", "--filter", "@pymes/api", "start"]
